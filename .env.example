# ==============================================================================
# VARIABLES DE ENTORNO DEL PROYECTO INVESTIGATIVO
# ==============================================================================

# 1. Base de Datos en la Nube (PostgreSQL - Supabase / Neon / AWS RDS)
# Si se deja vacía o no existe, el sistema usará SQLite local en: data/labor_market.db
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# 2. Parámetros opcionales del Scraper
DEFAULT_MAX_PAGES=5
DEFAULT_ROLE=cientifico-de-datos
